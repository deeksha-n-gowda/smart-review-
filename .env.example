# =============================================================================
# AI Code Review Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Django Core ---
SECRET_KEY=your-django-secret-key-change-this-to-something-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave blank to use SQLite (default for development)
DATABASE_URL=

# For PostgreSQL (production), set like:
# DATABASE_URL=postgresql://user:password@localhost:5432/code_review_db

# --- AES Encryption ---
# Must be exactly 32 bytes (256-bit key), base64-encoded.
# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
AES_SECRET_KEY=CHANGE_ME_32_BYTE_BASE64_KEY_HERE==

# --- Java Microservice ---
JAVA_SERVICE_HOST=localhost
JAVA_SERVICE_PORT=9090

# --- C# Service ---
# HTTP mode: the C# daemon runs as service "csharp" on the Docker network.
# (Named-pipe mode is only used for local out-of-Docker runs.)
CSHARP_PIPE_NAME=CodeReviewDaemonPipe
CSHARP_SERVICE_HOST=localhost
CSHARP_SERVICE_PORT=9091

# --- Full service URL overrides (optional) ---
# Take precedence over HOST/PORT above. On Render, a bare onrender.com
# hostname assigned via fromService is automatically upgraded to https://.
# JAVA_SERVICE_URL=http://localhost:9090
# CSHARP_SERVICE_URL=http://localhost:9091

# --- Microservice enrichment ---
# When "True", Java/C# uploads are additionally checked by the javac and
# Roslyn services. Set to "False" to run analysis fully locally.
MICROSERVICES_ENABLED=True

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
