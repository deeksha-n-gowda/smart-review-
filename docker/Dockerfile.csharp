# docker/Dockerfile.csharp — C# Analysis Daemon Container
# ==========================================================
# Multi-stage build:
#   Stage 1 (builder): restores NuGet packages and publishes a self-contained binary
#   Stage 2 (runtime): minimal .NET runtime image — runs the published binary
#
# Build (from project root):
#   docker build -f docker/Dockerfile.csharp -t codelens-csharp .
#
# Run standalone:
#   docker run -p 9091:9091 codelens-csharp

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim AS builder

WORKDIR /build

# Copy project file first to cache NuGet restore
COPY csharp_service/CodeReviewDaemon.csproj .
RUN dotnet restore

# Copy all source files
COPY csharp_service/ .

# Publish as framework-dependent (smaller) — requires .NET runtime in final image
RUN dotnet publish -c Release -o /publish /p:PublishSingleFile=false

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim AS runtime

LABEL maintainer="Capstone Team"
LABEL description="CodeLens — C# Analysis Daemon"
LABEL version="1.0"

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd --gid 1001 appgroup && \
    useradd  --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app
COPY --from=builder /publish .
RUN chown -R appuser:appgroup /app

USER appuser

ENV CSHARP_PORT=9091
ENV DAEMON_MODE=http
ENV DOTNET_RUNNING_IN_CONTAINER=true

EXPOSE 9091

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:9091/health || exit 1

ENTRYPOINT ["dotnet", "CodeReviewDaemon.dll", "--mode", "http"]
CMD ["--port", "9091"]